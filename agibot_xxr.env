# Source this file after activating the Python environment on DevCloud.
AGIBOT_XXR_REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export AGIBOT_PYTHON="${AGIBOT_PYTHON:-$(command -v python3)}"
export AGIBOT_SOURCE="${AGIBOT_SOURCE:-/apdcephfs_gy2/share_303214312/leoyizhang/datasets/agibot_beta_v3}"
export AGIBOT_OUTPUT=/apdcephfs_gy7/share_303588738/peterrao/pretrain_data/Agibot/run_glm53_flash_xhigh_grounded_v7_split2
export AGIBOT_SPLIT_DIR="$AGIBOT_XXR_REPO/.runtime/agibot_split2_xxr"
export AGIBOT_API_BASE=http://127.0.0.1:15721/tencent/v1
export AGIBOT_API_TOKEN_FILE="$AGIBOT_XXR_REPO/.api_token_xxr"
export AGIBOT_MODEL=glm-5.3-flash-ioa
export AGIBOT_REASONING_EFFORT=xhigh
export AGIBOT_TEMPERATURE=0.1
export AGIBOT_MAX_TOKENS=8192
export AGIBOT_CONCURRENCY=2
export AGIBOT_BATCH_SIZE=4
export AGIBOT_PROGRESS_EVERY=1000
unset AGIBOT_XXR_REPO
