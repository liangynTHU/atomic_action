{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recovery_cot_dataset.schema.json",
  "title": "Atomic recovery multimodal CoT training row",
  "type": "object",
  "required": [
    "schema",
    "data_kind",
    "sample_id",
    "sample_type",
    "episode_id",
    "episode_index",
    "segment_index",
    "task",
    "state_layout",
    "recovery_level",
    "failure_type",
    "source_failure_verified",
    "recovery_success",
    "training_eligible",
    "images",
    "image_roles",
    "image_frames",
    "previous_outcome",
    "history_outcome",
    "target",
    "conversations"
  ],
  "properties": {
    "schema": {"const": "atomic_recovery_cot_training_row"},
    "data_kind": {"const": "recovery"},
    "sample_id": {"type": "string", "minLength": 1},
    "sample_type": {"const": "recovery_transition"},
    "episode_id": {"type": "string", "minLength": 1},
    "episode_index": {"type": "integer", "minimum": 0},
    "segment_index": {"type": "integer", "minimum": 0},
    "task": {"type": "string", "minLength": 1},
    "state_layout": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "recovery_level": {"type": "integer", "minimum": 1, "maximum": 4},
    "failure_type": {"type": "string", "minLength": 1},
    "source_failure_verified": {"const": true},
    "recovery_success": {"const": true},
    "training_eligible": {"const": true},
    "images": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "image_roles": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "image_frames": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "integer", "minimum": 0}
    },
    "previous_outcome": {
      "type": "object",
      "required": [
        "status",
        "expected_subtask",
        "observed_outcome",
        "mismatch",
        "evidence",
        "annotation_source"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "failed_no_effect",
            "failed_different",
            "partial",
            "unknown"
          ]
        },
        "expected_subtask": {"type": "string"},
        "observed_outcome": {"type": "string"},
        "mismatch": {"type": "string"},
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "annotation_source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "history_outcome": {
      "enum": [
        "success",
        "failed_no_effect",
        "failed_different",
        "partial",
        "unknown"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "guide_action",
        "primary_action_verb",
        "sub_task",
        "num_chunks",
        "recovery_role"
      ],
      "properties": {
        "guide_action": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number"}
        },
        "primary_action_verb": {"type": "string", "minLength": 1},
        "sub_task": {"type": "string", "minLength": 1},
        "num_chunks": {"type": "integer", "minimum": 1},
        "recovery_role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "conversations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "required": ["from", "value"],
          "properties": {
            "from": {"const": "human"},
            "value": {"type": "string"}
          }
        },
        {
          "type": "object",
          "required": ["from", "value"],
          "properties": {
            "from": {"const": "gpt"},
            "value": {"type": "string"}
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
